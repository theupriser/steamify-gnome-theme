using Gtk 4.0;
using Adw 1;

template $CcUbuntuPanel: $CcPanel {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.Box {
      CenterBox no_settings_view {
        hexpand: true;
        vexpand: true;
        halign: center;
        valign: center;
        orientation: vertical;
        margin-top: 18;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;
        visible: false;

        [start]
        Image {
          icon-name: "face-sad-symbolic";
          pixel-size: 128;

          styles [
            "dim-label",
          ]
        }

        [center]
        Label {
          margin-top: 12;
          wrap: true;
          label: _("No Ubuntu settings found");
        }

        [end]
        Label {
          wrap: true;
          label: _("Oops, something has gone wrong. Please report a bug in Launchpad.");

          attributes: "scale 1.42";
        }
      }

      Adw.PreferencesPage {

        Adw.PreferencesGroup ding_preferences_group {
          /* Translators: Desktop icons settings. */
          title: _("Desktop Icons");

          header-suffix: Switch ding_switch {
            valign: center;
            visible: false;
            notify::active => $on_ding_switch_changed() swapped;
          };

          Adw.ComboRow ding_icon_size_row {
            use-underline: true;
            can-focus: true;
            width-request: 100;
            title: C_("Desktop Icons Size", "Si_ze");
            sensitive: bind ding_switch.active;
          }

          Adw.ComboRow ding_icons_new_alignment_row {
            use-underline: true;
            can-focus: true;
            width-request: 100;
            title: C_("Desktop Icons Size", "Position of _New Icons");
            sensitive: bind ding_switch.active;
          }

          Adw.SwitchRow ding_showhome_switch {
            title: _("Show _Home Folder");
            use-underline: true;
            sensitive: bind ding_switch.active;
          }
        }

        Adw.PreferencesGroup dock_preferences_group {
          margin-top: 16;

          /* Translators: Dock settings. */
          title: _("Dock");

          header-suffix: Switch dock_switch {
            valign: center;
            visible: false;
            notify::active => $on_dock_switch_changed() swapped;
          };

          Adw.SwitchRow dock_autohide_switch {
            title: _("_Auto-hide the Dock");
            subtitle: _("The dock hides when any windows overlap with it");
            use-underline: true;
            sensitive: bind dock_switch.active;
          }

          Adw.SwitchRow dock_extendheight_switch {
            title: _("Panel _Mode");
            subtitle: _("The dock extends to the screen edge");
            use-underline: true;
            sensitive: bind dock_switch.active;
          }

          Adw.ActionRow {
            use-underline: true;
            can-focus: true;
            title: _("_Icon Size");
            activatable: true;
            sensitive: bind dock_switch.active;

            Scale icon_size_scale {
              adjustment: icon_size_adjustment;
              orientation: horizontal;
              draw-value: true;
              value-pos: left;
              width-request: 264;
            }
          }

          Adw.ComboRow dock_monitor_row {
            use-underline: true;
            can-focus: true;
            width-request: 100;
            title: _("_Show on");
            sensitive: bind dock_switch.active;
            notify::selected-item => $on_dock_monitor_row_changed() swapped;
          }

          Adw.ComboRow dock_position_row {
            use-underline: true;
            can-focus: true;
            width-request: 100;
            title: _("_Position on Screen");
            sensitive: bind dock_switch.active;
          }

          Adw.ActionRow dock_behavior_row {
            can-focus: true;
            title: _("_Configure Dock Behavior");
            use-underline: true;
            activatable: true;
            sensitive: bind dock_switch.active;
            activated => $on_dock_behavior_row_activated(template);

            Image {
              icon-name: "go-next-symbolic";

              styles [
                "dim-label",
              ]
            }
          }
        }

        Adw.PreferencesGroup tiling_assistant_preferences_group {
          margin-top: 16;
          margin-bottom: 16;

          /* Translators: Tiling Assistant extension settings. */
          title: _("Enhanced Tiling");

          header-suffix: Switch tiling_assistant_switch {
            valign: center;
            notify::active => $on_tiling_assistant_switch_changed() swapped;
          };

          Adw.SwitchRow tiling_assistant_popup_switch {
            title: _("_Tiling Popup");

            /* Translators: Tiling Assistant Tiling Popup feature explanation. */
            subtitle: _("Show a list of open apps to fill empty screen space after tiling a window");
            use-underline: true;
            sensitive: bind tiling_assistant_switch.active;
          }

          Adw.SwitchRow tiling_assistant_tiling_group {
            title: _("Tile _Groups");

            /* Translators: Tiling Assistant Tile Groups feature explanation */
            subtitle: _("Keep windows grouped together when tiled, so that raising one brings up the group");
            use-underline: true;
            sensitive: bind tiling_assistant_switch.active;
          }
        }
      }
    };
  };
}

Adjustment icon_size_adjustment {
  step-increment: 1;
  page-increment: 4;
  value-changed => $on_icon_size_adjustment_value_changed(template);
}
